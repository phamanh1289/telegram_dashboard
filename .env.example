# Server-only variables. Never prefix with NEXT_PUBLIC.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local agent: prompt on stdin, draft on stdout. Tools disabled so chat text can't act.
# AI_AGENT_COMMAND=claude -p --tools ""
# When a project is picked in the UI the agent runs inside it with read-only tools:
# AI_AGENT_PROJECT_COMMAND=claude -p --tools Read,Grep,Glob --allowedTools Read,Grep,Glob
# "Tạo task" opens this interactive agent in Terminal inside the project:
# AI_TASK_COMMAND=claude
# Model for task sessions (default claude-haiku-5-5; empty = Claude Code default):
# AI_TASK_MODEL=claude-haiku-5-5
# Effort for task sessions: low | medium | high | xhigh | max (empty = Claude Code default):
# AI_TASK_EFFORT=medium
# Or an OpenAI-compatible endpoint (all three needed):
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# 0 = skip per-message consent grants (personal, single-user use only).
AI_REQUIRE_CONSENT=1
# macOS banner for each new tag (0 = off).
NOTIFY=1
# Optional: "YouTrack" button creates issues (permanent token from your YouTrack profile).
# YOUTRACK_URL=https://youtrack.example.com
# YOUTRACK_TOKEN=perm:...
# YOUTRACK_PROJECT=SDK
# Set automatically by `npm run dev`.
# APP_ORIGIN=http://127.0.0.1:8765
