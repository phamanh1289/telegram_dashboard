{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-fixture",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "exec", "--", "next", "dev", "web", "--hostname", "127.0.0.1", "--port", "3002"],
      "port": 3002,
      "url": "http://127.0.0.1:3002",
      "env": { "API_ORIGIN": "http://127.0.0.1:8767" }
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "e2e-fixture",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-sync", "python", "web/tests/fixture_server.py"],
      "port": 8766,
      "url": "http://127.0.0.1:8766"
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "telegram_dashboard",
        "serve"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765",
      "env": {
        "APP_ORIGIN": "http://127.0.0.1:3000"
      }
    }
  ]
}
